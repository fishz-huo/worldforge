{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorldForge",
  "version": "0.1.0",
  "identifier": "com.worldforge.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WorldForge 世界观工坊",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "WorldForge",
    "category": "Productivity",
    "shortDescription": "本地优先的世界观构建软件",
    "longDescription": "WorldForge 世界观工坊：卡片式设定 Wiki、可视化地图与时间轴、零切换写作，数据全部保存在本机。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
